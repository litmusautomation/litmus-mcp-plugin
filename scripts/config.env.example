# Litmus MCP plugin credentials. Copy this file to:
#   ~/.config/litmus-mcp/env
# The plugin's MCP server wrapper sources it on every launch.
#
# Codex users: this is the only supported way to provide credentials, since
# Codex does not surface plugin credential UIs.
# Claude users: optional. Claude prompts you for these at /plugin install time
# via userConfig and stores them in the system keychain. Use this file only if
# you want to bypass the in-app config (e.g. for shared dev machines).

# ---- Required: Litmus Edge connection ----
EDGE_URL=https://edge.example.com
EDGE_API_CLIENT_ID=your-oauth-client-id
EDGE_API_CLIENT_SECRET=your-oauth-client-secret

# Set to true only when your Edge has a CA-signed certificate.
VALIDATE_CERTIFICATE=false

# ---- Optional: NATS broker on the Edge (for live telemetry tools) ----
# NATS_SOURCE=localhost
# NATS_PORT=4222
# NATS_USER=
# NATS_PASSWORD=
# NATS_TOKEN=
# NATS_TLS=true

# ---- Optional: InfluxDB on the Edge (for historical data tools) ----
# INFLUX_HOST=
# INFLUX_PORT=8086
# INFLUX_DB_NAME=tsdata
# INFLUX_USERNAME=
# INFLUX_PASSWORD=

# ---- Optional: Litmus Edge Manager (for LEM tools and LEM bridge mode) ----
# EDGE_MANAGER_URL=https://lem.example.com
# EDGE_API_TOKEN=
# EDGE_MANAGER_PROJECT_ID=
# EDGE_MANAGER_DEVICE_ID=
# EDGE_MANAGER_ADMIN_URL=
